{
  "name": "anki-leaderboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "vite build",
    "dev": "npm run build:web && wrangler d1 migrations apply anki-leaderboard --local && wrangler dev --var INVITE_HMAC_KEY:local-dev-key-not-for-production-use",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p web --noEmit",
    "e2e": "playwright test",
    "e2e:server": "rm -rf .wrangler/e2e && npm run build:web && wrangler d1 migrations apply anki-leaderboard --local --persist-to .wrangler/e2e && wrangler dev --port ${E2E_PORT:-8787} --persist-to .wrangler/e2e --var INVITE_HMAC_KEY:e2e-only-key-not-for-production-use",
    "test:web": "vitest run -c vitest.web.config.ts",
    "test:addon": ".venv/bin/python -m pytest -q",
    "package:addon": "scripts/package-addon.sh",
    "test:all": "npm run typecheck && npm test && npm run test:web && npm run test:addon",
    "dev:login": "node scripts/dev-login.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
